# Copy to .env for local development. .env is gitignored — never commit real secrets.

# --- PostgreSQL (docker-compose + backend datasource) ---
DB_NAME=learnkk
DB_USERNAME=learnkk
DB_PASSWORD=change-me-locally
DB_PORT=5432

# Backend datasource URL (points at the docker-compose Postgres by default).
DB_URL=jdbc:postgresql://localhost:5432/learnkk

# --- Backend runtime ---
SERVER_PORT=8080

# Self-managed session secret (seed for opaque session tokens). Use a long random value.
SESSION_SECRET=change-me-to-a-long-random-string
