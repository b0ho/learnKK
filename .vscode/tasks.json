{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db: up (postgres)",
      "detail": "docker compose로 로컬 Postgres 컨테이너 기동",
      "type": "shell",
      "command": "docker compose up -d db",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "db: down",
      "detail": "로컬 Postgres 컨테이너 중지/삭제",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "backend: run (bootRun)",
      "detail": "Spring Boot 백엔드 실행 (local 프로파일, :8080). DB가 먼저 떠 있어야 함",
      "type": "shell",
      "command": "${workspaceFolder}/backend/gradlew",
      "args": ["bootRun", "--console=plain"],
      "windows": {
        "command": "${workspaceFolder}/backend/gradlew.bat",
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "SPRING_PROFILES_ACTIVE": "local"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Starting.*",
          "endsPattern": "^.*Started.*Application.*in.*seconds.*"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "always", "group": "run" }
    },
    {
      "label": "backend: test (unit)",
      "detail": "백엔드 단위 테스트 (통합/Testcontainers 제외)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/gradlew",
      "args": ["test", "--tests", "com.learnkk.auth.*", "--tests", "com.learnkk.meeting.*", "--tests", "com.learnkk.kernel.*", "--console=plain"],
      "windows": {
        "command": "${workspaceFolder}/backend/gradlew.bat",
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "backend: test (all + integration)",
      "detail": "전체 테스트. 통합 테스트는 Docker(Testcontainers) 필요",
      "type": "shell",
      "command": "${workspaceFolder}/backend/gradlew",
      "args": ["test", "--console=plain"],
      "windows": {
        "command": "${workspaceFolder}/backend/gradlew.bat",
        "options": {
          "env": {
            "DOCKER_HOST": "npipe:////./pipe/docker_engine"
          },
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "frontend: dev (vite)",
      "detail": "Vite 개발 서버 (:5173)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "windows": {
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*",
          "endsPattern": "^.*Local:.*http.*"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "always", "group": "run" }
    },
    {
      "label": "frontend: test",
      "detail": "Vitest 단건 실행 (watch 아님)",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "windows": {
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "frontend: test (coverage)",
      "detail": "Vitest 커버리지 리포트",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test:coverage"],
      "windows": {
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "stack: up (db + backend + frontend)",
      "detail": "DB 기동 후 백엔드와 프론트를 함께 실행 (풀스택 로컬 테스트)",
      "dependsOn": ["db: up (postgres)", "backend: run (bootRun)", "frontend: dev (vite)"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
